{
  "name": "scriptogram",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "scripts": {
    "start": "bun --env-file=.env --watch ./src/index.ts",
    "migrate_up": "bun --env-file=.env run ./src/migrations/migrate.ts --action up",
    "migrate_create": "bun --env-file=.env run ./src/migrations/migrate.ts --action create",
    "migrate_down": "bun --env-file=.env run ./src/migrations/migrate.ts --action down",
    "migrate_reset": "bun --env-file=.env run ./src/migrations/migrate.ts --action reset"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}